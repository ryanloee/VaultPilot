<UserControl
    x:Class="VaultPilot.WinUI.Controls.AiCommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Visibility="Collapsed">

    <!-- Semi-transparent backdrop -->
    <Grid x:Name="BackdropGrid" Background="#80000000"
          PointerPressed="OnBackdropPressed">

        <!-- Centered floating palette card -->
        <Border
            x:Name="PaletteCard"
            Width="520"
            MaxHeight="480"
            Padding="0"
            CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Translation="0,0,32">

            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search header -->
                <Border
                    Grid.Row="0"
                    Padding="16,14,16,12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Search icon -->
                        <FontIcon
                            Grid.Column="0"
                            Glyph="&#xE721;"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <!-- Search box -->
                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            PlaceholderText="搜索 AI 操作..."
                            TextChanged="OnSearchTextChanged"
                            KeyDown="OnSearchBoxKeyDown"
                            BorderThickness="0"
                            Background="Transparent"
                            FontSize="16"
                            AutomationProperties.Name="AI 操作搜索框"
                            AutomationProperties.HelpText="输入关键字搜索 AI 操作，或使用上下键选择、Enter 执行" />
                    </Grid>
                </Border>

                <!-- Action list -->
                <ListView
                    x:Name="ActionListView"
                    Grid.Row="1"
                    Margin="8,4,8,4"
                    SelectionMode="Single"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ItemTemplate="{StaticResource AiActionItemTemplate}"
                    SelectionChanged="OnActionSelectionChanged"
                    DoubleTapped="OnActionDoubleTapped"
                    AutomationProperties.Name="AI 操作列表"
                    AutomationProperties.HelpText="按上下键选择 AI 操作，Enter 或双击执行">
                </ListView>

                <!-- Footer status -->
                <Border
                    Grid.Row="2"
                    Padding="16,8,16,10"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Glyph="&#xE8A7;"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="1"
                            x:Name="FooterHint"
                            Text="↑↓ 选择 · Enter 执行 · Esc 关闭"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="2"
                            x:Name="ActionCountText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Result overlay (shown after executing an action) -->
        <Border
            x:Name="ResultCard"
            Width="520"
            MaxHeight="520"
            Padding="0"
            CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Translation="0,0,32"
            Visibility="Collapsed">

            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Result header -->
                <Border
                    Grid.Row="0"
                    Padding="16,12,16,12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            x:Name="ResultTitle"
                            FontWeight="SemiBold"
                            FontSize="16"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="操作结果标题" />

                        <TextBlock
                            Grid.Column="1"
                            Text="操作结果"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Center" />

                        <Button
                            Grid.Column="2"
                            x:Name="CloseResultButton"
                            Content="✕"
                            FontSize="14"
                            Padding="8,4,8,4"
                            MinWidth="0"
                            MinHeight="0"
                            Click="OnCloseResultClicked"
                            AutomationProperties.Name="关闭结果"
                            AutomationProperties.HelpText="关闭结果面板返回操作列表" />
                    </Grid>
                </Border>

                <!-- Result content -->
                <ScrollViewer
                    Grid.Row="1"
                    Padding="16,12,16,12"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="ResultTextBlock"
                        TextWrapping="Wrap"
                        FontSize="14"
                        AutomationProperties.Name="操作结果内容" />
                </ScrollViewer>

                <!-- Result footer -->
                <Border
                    Grid.Row="2"
                    Padding="16,8,16,10"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            x:Name="InsertToChatButton"
                            Content="插入到对话"
                            Padding="12,4,12,4"
                            MinWidth="0"
                            MinHeight="0"
                            FontSize="12"
                            Click="OnInsertToChatClicked"
                            AutomationProperties.Name="插入结果到对话"
                            AutomationProperties.HelpText="将操作结果插入到当前聊天消息框" />

                        <Button
                            Grid.Column="1"
                            x:Name="CopyResultButton"
                            Content="复制"
                            Padding="12,4,12,4"
                            MinWidth="0"
                            MinHeight="0"
                            FontSize="12"
                            Click="OnCopyResultClicked"
                            AutomationProperties.Name="复制结果"
                            AutomationProperties.HelpText="将操作结果复制到剪贴板" />

                        <TextBlock
                            Grid.Column="2"
                            x:Name="ResultUsageText"
                            Text=""
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border
            x:Name="LoadingOverlay"
            Width="520"
            Height="140"
            Padding="0"
            CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Translation="0,0,32"
            Visibility="Collapsed">

            <StackPanel Orientation="Vertical" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing IsActive="True" Width="32" Height="32" />
                <TextBlock x:Name="LoadingText" Text="正在处理..." FontSize="14"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="处理中" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
