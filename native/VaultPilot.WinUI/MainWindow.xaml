<Window
    x:Class="VaultPilot.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="VaultPilot">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="8,4,8,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="StatusBar"
                Grid.Column="0"
                MinWidth="280"
                Padding="12,6,12,6"
                CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon x:Name="StatusBarIcon" Glyph="&#xE946;" FontSize="14" Foreground="SteelBlue" />
                    <TextBlock x:Name="StatusBarTitle" Text="正在启动" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock x:Name="StatusBarMessage" Text="正在连接 Rust 后端..." Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </Border>
            <CommandBar
                Grid.Column="1"
                DefaultLabelPosition="Right"
                IsOpen="False">
                <AppBarButton x:Name="ToggleSidebarButton" Icon="OpenPane" Label="收起会话" />
                <AppBarButton x:Name="ImportButton" Icon="Import" Label="导入 Markdown" />
                <AppBarButton x:Name="RebuildButton" Icon="Refresh" Label="重建索引" />
                <AppBarButton x:Name="SettingsButton" Icon="Setting" Label="设置" />
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" Padding="24" RowSpacing="16">
            <Grid x:Name="ContentGrid" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="SidebarBorder"
                    Grid.Column="0"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="会话" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Grid.Row="1" x:Name="NotesText" Text="笔记：正在加载..." />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="NewSessionButton" Content="新建对话" />
                            <Button x:Name="DeleteSessionButton" Content="删除当前会话" />
                        </StackPanel>
                        <ListView
                            x:Name="SessionList"
                            Grid.Row="3"
                            MinHeight="0"
                            SelectionMode="Single"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            Text="{Binding Detail}"
                                            Opacity="0.7"
                                            Style="{ThemeResource BodyTextBlockStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <ScrollViewer
                            x:Name="ChatScrollViewer"
                            Margin="0,0,-10,0"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                x:Name="MessagesPanel"
                                Margin="0,0,18,0"
                                Spacing="12">
                                <TextBlock Text="对话" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="正在接入原生 Windows 界面。" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                        <Button
                            x:Name="JumpLatestButton"
                            Margin="0,8,0,0"
                            Padding="12,6,12,6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Content="回到最新对话"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Padding="24,0,24,24">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddImageButton" Content="添加图片" />
                    <ScrollViewer
                        x:Name="AttachmentScroller"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        Visibility="Collapsed">
                        <StackPanel x:Name="AttachmentPanel" Orientation="Horizontal" Spacing="8" />
                    </ScrollViewer>
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="ComposerBox"
                        Grid.Column="0"
                        AcceptsReturn="True"
                        Height="88"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap"
                        PlaceholderText="输入问题，或记录一条知识...">
                        <TextBox.KeyboardAccelerators>
                            <KeyboardAccelerator x:Name="ComposerSendAccelerator" Key="Enter" />
                        </TextBox.KeyboardAccelerators>
                    </TextBox>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="10" HorizontalAlignment="Center">
                        <Ellipse
                            x:Name="ContextRing"
                            Width="16"
                            Height="16"
                            Stroke="ForestGreen"
                            StrokeThickness="2.5"
                            Fill="Transparent"
                            HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="RecordButton"
                                Content="记录知识" />
                            <Button
                                x:Name="SendButton"
                                Content="发送" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
