<ContentDialog
    x:Class="VaultPilot.WinUI.Views.StartupStatsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="启动耗时统计"
    CloseButtonText="关闭"
    Width="480">

    <!-- Rows are built in code-behind (Populate) so no DataTemplate/binding
         markup is needed; matches the ShowWriteApprovalDialog pattern. -->
    <ScrollViewer
        MaxHeight="520"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="PhasePanel"
            Spacing="6"
            Padding="0,4"
            HorizontalAlignment="Stretch" />
    </ScrollViewer>
</ContentDialog>
