<Window
    x:Class="VaultPilot.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:VaultPilot.WinUI.Controls"
    mc:Ignorable="d"
    Title="VaultPilot">

    <Grid x:Name="RootGrid" Background="{ThemeResource VaultSurfaceBg}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewSessionAccelerator" />
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="OnToggleSidebarAccelerator" />
            <KeyboardAccelerator Key="P" Modifiers="Control,Shift" Invoked="OnAiCommandPaletteAccelerator" />
            <KeyboardAccelerator Key="Q" Modifiers="Control,Shift" Invoked="OnQuickAskAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- ══ Root: 3-column VS Code-style layout ══
             Col 0: Activity bar (icons only, 48px)
             Col 1: Side panel (sessions list / notes, collapsible)
             Col 2: Main area (chat / notes detail) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SidebarColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Activity bar (left icon rail) ── -->
            <Border Grid.Column="0" Width="48" Background="{ThemeResource VaultCardBg}"
                    BorderBrush="{ThemeResource VaultBorder}" BorderThickness="0,0,1,0">
                <Grid RowSpacing="4" Padding="0,12,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand mark -->
                    <Border Grid.Row="0" Width="28" Height="28" CornerRadius="6"
                            Background="{ThemeResource VaultLogoBg}"
                            HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="V" FontWeight="Bold" FontSize="13"
                                   Foreground="{ThemeResource VaultLogoFg}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Nav: Chat -->
                    <Button x:Name="NavChatButton" Grid.Row="1" Style="{StaticResource VaultIconButtonStyle}"
                            Width="40" Height="40" CornerRadius="6"
                            Click="OnActivityChatClicked"
                            AutomationProperties.Name="对话" AutomationProperties.HelpText="切换到聊天界面">
                        <FontIcon Glyph="&#xE8BD;" FontSize="16" />
                    </Button>

                    <!-- Nav: Notes -->
                    <Button x:Name="NavNotesButton" Grid.Row="2" Style="{StaticResource VaultIconButtonStyle}"
                            Width="40" Height="40" CornerRadius="6"
                            Click="OnActivityNotesClicked"
                            AutomationProperties.Name="笔记" AutomationProperties.HelpText="切换到笔记浏览界面">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                    </Button>

                    <!-- Spacer -->

                    <!-- Settings (bottom) -->
                    <Button x:Name="SettingsButton" Grid.Row="4" Style="{StaticResource VaultIconButtonStyle}"
                            Width="40" Height="40" CornerRadius="6"
                            AutomationProperties.Name="设置" AutomationProperties.HelpText="打开设置对话框">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                </Grid>
            </Border>

            <!-- ── Side panel (sessions list, collapsible) ── -->
            <!-- NOTE: both ChatView/NotesViewHost live in the main area (col 2).
                 This side panel hosts the session list when in chat mode.
                 It is shown/hidden by setting SidebarColumn.Width. -->
            <Border x:Name="SidebarBorder" Grid.Column="1"
                    Background="{ThemeResource VaultCardBg}"
                    BorderBrush="{ThemeResource VaultBorder}" BorderThickness="0,0,1,0"
                    Visibility="Collapsed">
                <Grid Padding="8,12,8,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Panel header: title + collapse button -->
                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="会话" FontSize="{StaticResource VaultFontSizeMedium}"
                                   FontWeight="SemiBold" Foreground="{ThemeResource VaultTextPrimary}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ToggleSidebarButton" Grid.Column="1"
                                Style="{StaticResource VaultIconButtonStyle}" Width="28" Height="28"
                                AutomationProperties.Name="收起侧边栏" AutomationProperties.HelpText="折叠会话列表">
                            <FontIcon Glyph="&#xE89F;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- New / delete session -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="4,0,4,8">
                        <Button x:Name="NewSessionButton" Style="{StaticResource VaultOutlinedIconButtonStyle}"
                                Width="32" Height="32"
                                AutomationProperties.Name="新建对话" AutomationProperties.HelpText="创建一个新的聊天会话">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                        <Button x:Name="DeleteSessionButton" Style="{StaticResource VaultOutlinedIconButtonStyle}"
                                Width="32" Height="32"
                                AutomationProperties.Name="删除当前会话" AutomationProperties.HelpText="删除当前选中的聊天会话">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource StatusErrorBrush}" />
                        </Button>
                    </StackPanel>

                    <!-- Notes count -->
                    <TextBlock Grid.Row="2" x:Name="NotesText" Text="笔记：正在加载..."
                               FontSize="{StaticResource VaultFontSizeSmall}"
                               Foreground="{ThemeResource VaultTextSecondary}"
                               Margin="4,0,4,8"
                               AutomationProperties.Name="笔记状态" AutomationProperties.HelpText="显示笔记同步状态信息" />

                    <!-- Session list -->
                    <ListView
                        x:Name="SessionList"
                        Grid.Row="3"
                        MinHeight="0"
                        SelectionMode="Single"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Padding="0"
                        AutomationProperties.Name="会话列表" AutomationProperties.HelpText="选择一个聊天会话">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Padding="2,4">
                                    <TextBlock Text="{Binding Title}" TextWrapping="WrapWholeWords"
                                               FontSize="{StaticResource VaultFontSizeSmall}"
                                               Foreground="{ThemeResource VaultTextPrimary}" />
                                    <TextBlock Text="{Binding Detail}"
                                               Foreground="{ThemeResource VaultTextSecondary}"
                                               FontSize="{StaticResource VaultFontSizeCaption}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ── Main area ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top bar: status + quick actions -->
                <Grid Grid.Row="0" Height="44" Padding="12,0,8,0"
                      Background="{ThemeResource VaultSurfaceBg}"
                      BorderBrush="{ThemeResource VaultBorder}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Expand sidebar button (shown when collapsed) -->
                    <Button x:Name="ExpandSidebarButton" Grid.Column="0"
                            Style="{StaticResource VaultIconButtonStyle}" Width="36" Height="36"
                            Click="OnExpandSidebarClicked"
                            AutomationProperties.Name="展开侧边栏" AutomationProperties.HelpText="展开会话列表">
                        <FontIcon Glyph="&#xE700;" FontSize="14" />
                    </Button>

                    <!-- Inline status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" Margin="8,0,0,0">
                        <FontIcon x:Name="StatusBarIcon" Glyph="&#xE946;" FontSize="11"
                                  Foreground="{ThemeResource StatusBarIconBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusBarTitle" Text="正在启动" FontWeight="SemiBold"
                                   FontSize="{StaticResource VaultFontSizeSmall}"
                                   Foreground="{ThemeResource VaultTextPrimary}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="·" FontSize="{StaticResource VaultFontSizeSmall}" Opacity="0.4"
                                   Foreground="{ThemeResource VaultTextMuted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusBarMessage" Text="正在连接 Rust 后端..."
                                   Opacity="0.7" FontSize="{StaticResource VaultFontSizeSmall}"
                                   Foreground="{ThemeResource VaultTextSecondary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Quick actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button x:Name="RebuildButton" Style="{StaticResource VaultIconButtonStyle}"
                                Width="36" Height="36"
                                AutomationProperties.Name="重建索引" AutomationProperties.HelpText="扫描知识库并重建搜索索引">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                        <Button x:Name="ImportButton" Style="{StaticResource VaultIconButtonStyle}"
                                Width="36" Height="36"
                                AutomationProperties.Name="导入 Markdown" AutomationProperties.HelpText="从文件导入 Markdown 笔记">
                            <FontIcon Glyph="&#xE8B5;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Content region: chat view + notes host -->
                <Grid Grid.Row="1">
                    <!-- ══ Chat view ══ -->
                    <Grid x:Name="ChatView" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Message thread -->
                        <ScrollViewer
                            x:Name="ChatScrollViewer"
                            Grid.Row="0"
                            Padding="24,20,24,12"
                            VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <StackPanel
                                    x:Name="MessagesPanel"
                                    Spacing="18"
                                    HorizontalAlignment="Stretch"
                                    ChildrenTransitions="{StaticResource AppChildrenTransitions}">
                                    <TextBlock Text="对话" FontSize="{StaticResource VaultFontSizeMedium}"
                                               FontWeight="SemiBold" Foreground="{ThemeResource VaultTextPrimary}" />
                                    <TextBlock Text="正在接入原生 Windows 界面。" TextWrapping="Wrap"
                                               FontSize="{StaticResource VaultFontSizeBody}"
                                               Foreground="{ThemeResource VaultTextSecondary}" />
                                </StackPanel>

                                <!-- Jump-to-latest floating button -->
                                <Button
                                    x:Name="JumpLatestButton"
                                    Margin="0,0,0,12"
                                    Padding="12,6,12,6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="{StaticResource VaultRadiusPill}"
                                    Background="{ThemeResource VaultCardElevatedBg}"
                                    BorderBrush="{ThemeResource VaultBorder}"
                                    BorderThickness="1"
                                    Content="回到最新对话"
                                    FontSize="{StaticResource VaultFontSizeCaption}"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="回到最新对话" AutomationProperties.HelpText="滚动到最新的聊天消息" />
                            </Grid>
                        </ScrollViewer>

                        <!-- Agent tool call status panel (overlays above composer) -->
                        <Border
                            x:Name="AgentToolCallPanel"
                            Grid.Row="0"
                            Margin="32,0,32,0"
                            Padding="12"
                            VerticalAlignment="Bottom"
                            CornerRadius="{StaticResource VaultRadiusMedium}"
                            Background="{ThemeResource VaultCardElevatedBg}"
                            BorderBrush="{ThemeResource VaultBorder}"
                            BorderThickness="1"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Agent 工具调用面板">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="AgentStatusText" Text="Agent 运行中..." FontWeight="SemiBold"
                                               FontSize="{StaticResource VaultFontSizeSmall}"
                                               Foreground="{ThemeResource VaultTextPrimary}" />
                                    <TextBlock x:Name="AgentStepCount" Text="步骤: 0/20" Opacity="0.7"
                                               FontSize="{StaticResource VaultFontSizeCaption}"
                                               Foreground="{ThemeResource VaultTextSecondary}" />
                                    <TextBlock x:Name="AgentTokenCount" Text="Token: 0" Opacity="0.7"
                                               FontSize="{StaticResource VaultFontSizeCaption}"
                                               Foreground="{ThemeResource VaultTextSecondary}" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="AgentToolCallList" Spacing="4" />
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- ══ Capsule composer (bottom) ══ -->
                        <Grid Grid.Row="1" Padding="24,8,24,16">
                            <Border x:Name="ComposerDropZone"
                                    Background="{ThemeResource VaultInputBg}"
                                    CornerRadius="{StaticResource VaultRadiusLarge}"
                                    BorderBrush="{ThemeResource VaultBorder}"
                                    BorderThickness="1"
                                    Padding="6,6,6,6"
                                    AllowDrop="True"
                                    DragOver="OnComposerDropZoneDragOver"
                                    Drop="OnComposerDropZoneDrop"
                                    AutomationProperties.Name="消息编辑区域"
                                    AutomationProperties.HelpText="支持拖放文件作为附件">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Attachments row (full width, above input) -->
                                    <ScrollViewer
                                        x:Name="AttachmentScroller"
                                        Grid.Row="0" Grid.ColumnSpan="3"
                                        Margin="0,0,0,4"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Disabled"
                                        Visibility="Collapsed"
                                        AutomationProperties.Name="附件列表"
                                        AutomationProperties.HelpText="已添加的附件，可左右滚动浏览">
                                        <StackPanel
                                            x:Name="AttachmentPanel"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            AutomationProperties.Name="附件面板" />
                                    </ScrollViewer>

                                    <!-- Left: attachment / record buttons -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="2">
                                        <Button x:Name="RecordButton" Style="{StaticResource VaultIconButtonStyle}"
                                                Width="32" Height="32"
                                                ToolTipService.ToolTip="将当前对话内容记录到知识库"
                                                AutomationProperties.Name="记录" AutomationProperties.HelpText="将当前对话内容记录到知识库">
                                            <FontIcon Glyph="&#xE7C8;" FontSize="14" />
                                        </Button>
                                        <Button x:Name="AgentModeButton" Style="{StaticResource VaultIconButtonStyle}"
                                                Width="32" Height="32"
                                                ToolTipService.ToolTip="启动 Agent 模式 — AI 自主执行多步工具调用"
                                                AutomationProperties.Name="Agent 模式" AutomationProperties.HelpText="启动自主 AI Agent 执行多步工具调用">
                                            <FontIcon Glyph="&#xE7BF;" FontSize="14" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Center: input + context bar + hint -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBox
                                            x:Name="ComposerBox"
                                            AcceptsReturn="False"
                                            MinHeight="40"
                                            MaxHeight="140"
                                            TextChanged="OnComposerTextChanged"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            TextWrapping="Wrap"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            PlaceholderText="输入问题，或记录一条知识..."
                                            FontSize="{StaticResource VaultFontSizeBody}"
                                            Padding="8,8,8,8"
                                            ToolTipService.ToolTip="Enter 发送消息，Shift+Enter 插入换行"
                                            AutomationProperties.Name="消息输入框" AutomationProperties.HelpText="输入要发送的消息，Enter 发送，Shift+Enter 换行" />
                                        <Grid
                                            x:Name="ContextUsageBarHost"
                                            Height="6"
                                            Margin="8,0,8,2"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            SizeChanged="OnContextUsageBarHostSizeChanged"
                                            AutomationProperties.Name="上下文使用量" AutomationProperties.HelpText="显示当前会话的上下文窗口使用百分比">
                                            <Border
                                                x:Name="ContextUsageTrack"
                                                Height="3"
                                                CornerRadius="{StaticResource VaultRadiusPill}"
                                                Background="{ThemeResource ContextUsageTrackBrush}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center" />
                                            <Border
                                                x:Name="ContextUsageFill"
                                                Height="3"
                                                Width="0"
                                                CornerRadius="{StaticResource VaultRadiusPill}"
                                                Background="{ThemeResource ContextUsageFillBrush}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Right: send / cancel / stop buttons -->
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                        <Button x:Name="CancelButton" Style="{StaticResource VaultIconButtonStyle}"
                                                Width="32" Height="32"
                                                Visibility="Collapsed"
                                                AutomationProperties.Name="取消" AutomationProperties.HelpText="取消当前 AI 请求">
                                            <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource StatusErrorBrush}" />
                                        </Button>
                                        <Button x:Name="StopAgentButton" Style="{StaticResource VaultIconButtonStyle}"
                                                Width="32" Height="32"
                                                Visibility="Collapsed"
                                                AutomationProperties.Name="停止 Agent" AutomationProperties.HelpText="立即终止 Agent 执行">
                                            <FontIcon Glyph="&#xE71A;" FontSize="14" Foreground="{ThemeResource StatusErrorBrush}" />
                                        </Button>
                                        <Button x:Name="SendButton"
                                                Style="{StaticResource VaultAccentButtonStyle}"
                                                Width="36" Height="36"
                                                AutomationProperties.Name="发送" AutomationProperties.HelpText="发送消息到 AI">
                                            <FontIcon Glyph="&#xE72A;" FontSize="15" Foreground="{ThemeResource VaultOnAccentForeground}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Notes view: populated in code-behind -->
                    <Grid x:Name="NotesViewHost" Visibility="Collapsed" Padding="0" />

                    <!-- Hidden ComposerHintText kept for code-behind compat (was used by old layout) -->
                    <TextBlock x:Name="ComposerHintText" Text="Enter 发送 · Shift+Enter 换行" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ══ Global AI Command Palette overlay (#2188) ══ -->
        <controls:AiCommandPalette
            x:Name="AiCommandPaletteControl"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!-- ══ Quick Ask overlay (#1799) ══ -->
        <controls:QuickAskOverlay
            x:Name="QuickAskControl"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!-- AI Command Palette overlay (Phase 2 of #2188) — hidden by default -->
        <Grid
            x:Name="AiCommandPaletteHost"
            Visibility="Collapsed"
            IsHitTestVisible="False" />

    </Grid>
</Window>
