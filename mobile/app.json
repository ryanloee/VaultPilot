{
  "expo": {
    "name": "VaultPilot",
    "slug": "vaultpilot",
    "version": "0.6.81",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A5F"
    },
    "android": {
      "package": "com.vaultpilot.mobile",
      "versionCode": 681,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_VISUAL_USER_SELECTED",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1E3A5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.vaultpilot.mobile"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-splash-screen",
      "./plugins/withQuickSettingsTile.js",
      "./plugins/withDesktopWidget.js",
      "expo-speech-recognition",
      "expo-camera",
      "expo-task-manager",
      "expo-background-task",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 5,
              "supportsWebPageWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "application/pdf"
            ],
            "multipleShareMimeTypes": [
              "image/*"
            ]
          }
        }
      ]
    ],
    "install": {
      "exclude": [
        "expo-speech-recognition"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "ec06327b-5d3d-4147-8d79-b86be2b2996f"
      }
    }
  }
}
