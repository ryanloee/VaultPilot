{
  "name": "vaultpilot-clipper",
  "version": "1.0.0",
  "private": true,
  "description": "VaultPilot 浏览器剪藏扩展",
  "scripts": {
    "build": "tsc && cp node_modules/turndown/dist/turndown.js lib/ && cp node_modules/@mozilla/readability/Readability.js lib/",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/chrome": "^0.0.260"
  }
}
