[package]
name = "vaultpilot-desktop"
version = "0.1.0"
description = "VaultPilot desktop frontend (Tauri v2 + React)"
edition = "2021"
rust-version = "1.77"

[lib]
name = "vaultpilot_desktop_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2", features = [] }

[dependencies]
tauri = { version = "2", features = ["tray-icon"] }
tauri-plugin-opener = "2"
tauri-plugin-process = "2"
tauri-plugin-updater = "2"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
base64 = "0.23"
chrono = "0.4"
tokio = { version = "1", features = ["sync"] }
anyhow = "1"
# ★ Direct dependency on the existing backend library — zero IPC.
# Every #[tauri::command] calls vaultpilot_lib functions in-process.
# (The crate is published as package `vaultpilot`; its lib name is
# `vaultpilot_lib`, which is what `use vaultpilot_lib::...` refers to.)
[target.'cfg(not(any(target_os = "android", target_os = "ios")))'.dependencies]
vaultpilot = { path = "../.." }

[target.'cfg(any(target_os = "android", target_os = "ios"))'.dependencies]
# Mobile builds drop the email/IMAP feature (native-tls → openssl-sys cannot
# cross-compile for Android). All other backend functionality is unchanged.
vaultpilot = { path = "../..", default-features = false }

[features]
# By default Tauri bundles the frontend assets shipped by `tauri dev/build`.
# The custom-protocol feature is enabled at build time by tauri-build.
custom-protocol = ["tauri/custom-protocol"]
