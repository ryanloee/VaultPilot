<Window
    x:Class="VaultPilot.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:VaultPilot.WinUI.Controls"
    mc:Ignorable="d"
    Title="VaultPilot">

    <Grid x:Name="RootGrid" Background="{ThemeResource VaultSurfaceBg}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewSessionAccelerator" />
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="OnToggleSidebarAccelerator" />
            <KeyboardAccelerator Key="P" Modifiers="Control,Shift" Invoked="OnAiCommandPaletteAccelerator" />
            <KeyboardAccelerator Key="Q" Modifiers="Control,Shift" Invoked="OnQuickAskAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact header bar -->
        <Grid Grid.Row="0" Padding="8,4,12,4" Background="{ThemeResource VaultCardBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Logo badge -->
            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5"
                    Background="{ThemeResource VaultAccentBlue}" VerticalAlignment="Center">
                <TextBlock Text="V" FontWeight="Bold" FontSize="11" Foreground="White"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="VaultPilot" FontWeight="SemiBold" FontSize="13"
                VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{ThemeResource VaultTextPrimary}" />
            <!-- Inline status -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                VerticalAlignment="Center" Margin="16,0,0,0">
                <FontIcon x:Name="StatusBarIcon" Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource StatusBarIconBrush}" />
                <TextBlock x:Name="StatusBarTitle" Text="正在启动" FontWeight="SemiBold" FontSize="12"
                    VerticalAlignment="Center" Foreground="{ThemeResource VaultTextPrimary}" />
                <TextBlock x:Name="StatusBarMessage" Text="正在连接 Rust 后端..."
                    Opacity="0.55" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource VaultTextSecondary}" />
            </StackPanel>
            <!-- Quick actions as icon buttons -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                <Button x:Name="RebuildButton" MinWidth="0" MinHeight="0" Width="28" Height="28"
                    Padding="0" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="重建索引">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{ThemeResource VaultTextSecondary}" />
                </Button>
                <Button x:Name="ImportButton" MinWidth="0" MinHeight="0" Width="28" Height="28"
                    Padding="0" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="导入 Markdown">
                    <FontIcon Glyph="&#xE8B6;" FontSize="12" Foreground="{ThemeResource VaultTextSecondary}" />
                </Button>
                <Button x:Name="ToggleSidebarButton" MinWidth="0" MinHeight="0" Width="28" Height="28"
                    Padding="0" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="切换侧边栏">
                    <FontIcon Glyph="&#xE700;" FontSize="12" Foreground="{ThemeResource VaultTextSecondary}" />
                </Button>
                <Button x:Name="SettingsButton" MinWidth="0" MinHeight="0" Width="28" Height="28"
                    Padding="0" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="设置">
                    <FontIcon Glyph="&#xE713;" FontSize="12" Foreground="{ThemeResource VaultTextSecondary}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- NavigationView + content area -->
        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavChat"
                    Content="对话"
                    Icon="Message"
                    Tag="Chat"
                    IsSelected="True"
                    AutomationProperties.Name="对话"
                    AutomationProperties.HelpText="切换到聊天界面" />
                <NavigationViewItem
                    x:Name="NavNotes"
                    Content="笔记"
                    Tag="Notes"
                    AutomationProperties.Name="笔记"
                    AutomationProperties.HelpText="切换到笔记浏览界面" />
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Grid>
                    <!-- Chat view -->
                    <Grid x:Name="ChatView" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="24" RowSpacing="16">
                            <Grid x:Name="ContentGrid" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="SidebarColumn" Width="280" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="SidebarBorder"
                                    Grid.Column="0"
                                    Padding="16"
                                    Background="{ThemeResource VaultSidebarBg}"
                                    CornerRadius="8">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="会话" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock Grid.Row="1" x:Name="NotesText" Text="笔记：正在加载..."
                                            AutomationProperties.Name="笔记状态" AutomationProperties.HelpText="显示笔记同步状态信息" />
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="NewSessionButton"
                                                AutomationProperties.Name="新建对话" AutomationProperties.HelpText="创建一个新的聊天会话">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                                    <TextBlock Text="新建对话" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="DeleteSessionButton" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                AutomationProperties.Name="删除当前会话" AutomationProperties.HelpText="删除当前选中的聊天会话">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    <TextBlock Text="删除当前会话" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <ListView
                                            x:Name="SessionList"
                                            Grid.Row="3"
                                            MinHeight="0"
                                            SelectionMode="Single"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            AutomationProperties.Name="会话列表" AutomationProperties.HelpText="选择一个聊天会话">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Title}" TextWrapping="WrapWholeWords" />
                                                        <TextBlock
                                                            Text="{Binding Detail}"
                                                            Foreground="{ThemeResource SecondaryTextBrush}"
                                                            Style="{ThemeResource BodyTextBlockStyle}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="16"
                                    Background="{ThemeResource VaultCardBg}"
                                    CornerRadius="8">
                                    <Grid>
                                        <ScrollViewer
                                            x:Name="ChatScrollViewer"
                                            Margin="0,0,-10,0"
                                            VerticalScrollBarVisibility="Auto">
                                            <StackPanel
                                                x:Name="MessagesPanel"
                                                Margin="0,0,18,0"
                                                Spacing="12">
                                                <TextBlock Text="对话" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                                <TextBlock Text="正在接入原生 Windows 界面。" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ScrollViewer>
                                        <!-- Agent tool call status panel -->
                                        <Border
                                            x:Name="AgentToolCallPanel"
                                            Grid.Row="1"
                                            Padding="12"
                                            Margin="0,8,0,0"
                                            CornerRadius="6"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="Agent 工具调用面板">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <!-- Agent status header -->
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock x:Name="AgentStatusText" Text="Agent 运行中..." FontWeight="SemiBold" />
                                                    <TextBlock x:Name="AgentStepCount" Text="步骤: 0/20" Opacity="0.7" />
                                                    <TextBlock x:Name="AgentTokenCount" Text="Token: 0" Opacity="0.7" />
                                                </StackPanel>
                                                <!-- Tool call list -->
                                                <ScrollViewer Grid.Row="1" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel x:Name="AgentToolCallList" Spacing="4" />
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                        <Button
                                            x:Name="JumpLatestButton"
                                            Margin="0,8,0,0"
                                            Padding="12,6,12,6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Content="回到最新对话"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="回到最新对话" AutomationProperties.HelpText="滚动到最新的聊天消息" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" Padding="24,0,24,16">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        x:Name="ComposerDropZone"
                                        Grid.Column="0"
                                        RowSpacing="6"
                                        Padding="12,8,12,8"
                                        AllowDrop="True"
                                        DragOver="OnComposerDropZoneDragOver"
                                        Drop="OnComposerDropZoneDrop"
                                        AutomationProperties.Name="消息编辑区域"
                                        AutomationProperties.HelpText="支持拖放文件作为附件">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox
                                            x:Name="ComposerBox"
                                            Grid.Row="0"
                                            AcceptsReturn="False"
                                            MinHeight="48"
                                            MaxHeight="120"
                                            TextChanged="OnComposerTextChanged"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            TextWrapping="Wrap"
                                            PlaceholderText="输入问题，或记录一条知识..."
                                            ToolTipService.ToolTip="Enter 发送消息，Shift+Enter 插入换行"
                                            AutomationProperties.Name="消息输入框" AutomationProperties.HelpText="输入要发送的消息，Enter 发送，Shift+Enter 换行">
                                        </TextBox>
                                        <TextBlock
                                            x:Name="ComposerHintText"
                                            Grid.Row="1"
                                            Text="Enter 发送 · Shift+Enter 换行"
                                            FontSize="11"
                                            Foreground="{ThemeResource VaultTextMuted}"
                                            Margin="4,0,0,0"
                                            HorizontalAlignment="Right" />
                                        <Grid
                                            x:Name="ContextUsageBarHost"
                                            Grid.Row="3"
                                            Height="8"
                                            MinWidth="120"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            SizeChanged="OnContextUsageBarHostSizeChanged"
                                            AutomationProperties.Name="上下文使用量" AutomationProperties.HelpText="显示当前会话的上下文窗口使用百分比">
                                            <Border
                                                x:Name="ContextUsageTrack"
                                                Height="4"
                                                CornerRadius="2"
                                                Background="{ThemeResource ContextUsageTrackBrush}"
                                                Opacity="0.32"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center" />
                                            <Border
                                                x:Name="ContextUsageFill"
                                                Height="4"
                                                Width="0"
                                                CornerRadius="2"
                                                Background="{ThemeResource ContextUsageFillBrush}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                        <ScrollViewer
                                            x:Name="AttachmentScroller"
                                            Grid.Row="4"
                                            Margin="0,4,0,0"
                                            HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Disabled"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="附件列表"
                                            AutomationProperties.HelpText="已添加的附件，可左右滚动浏览">
                                            <StackPanel
                                                x:Name="AttachmentPanel"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="附件面板" />
                                        </ScrollViewer>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6" HorizontalAlignment="Center">
                                        <Button
                                            x:Name="RecordButton"
                                            MinWidth="0" MinHeight="0" Width="32" Height="32"
                                            Padding="0" Background="Transparent" BorderThickness="1"
                                            BorderBrush="{ThemeResource VaultBorder}"
                                            CornerRadius="8"
                                            ToolTipService.ToolTip="将当前对话内容记录到知识库"
                                            AutomationProperties.Name="记录" AutomationProperties.HelpText="将当前对话内容记录到知识库">
                                            <FontIcon Glyph="&#xE7C8;" FontSize="14" Foreground="{ThemeResource VaultTextSecondary}" />
                                        </Button>
                                        <Button
                                            x:Name="SendButton"
                                            MinWidth="0" MinHeight="0" Width="32" Height="32"
                                            Padding="0"
                                            CornerRadius="8"
                                            Background="{ThemeResource VaultAccentBlue}"
                                            BorderThickness="0"
                                            AutomationProperties.Name="发送" AutomationProperties.HelpText="发送消息到 AI">
                                            <FontIcon Glyph="&#x2191;" FontSize="14" Foreground="White" />
                                        </Button>
                                        <Button
                                            x:Name="CancelButton"
                                            MinWidth="0" MinHeight="0" Width="32" Height="32"
                                            Padding="0" Background="Transparent" BorderThickness="1"
                                            BorderBrush="{ThemeResource VaultBorder}"
                                            CornerRadius="8"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="取消" AutomationProperties.HelpText="取消当前 AI 请求">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource VaultAccentRed}" />
                                        </Button>
                                        <Button
                                            x:Name="AgentModeButton"
                                            MinWidth="0" MinHeight="0" Width="32" Height="32"
                                            Padding="0" Background="Transparent" BorderThickness="1"
                                            BorderBrush="{ThemeResource VaultBorder}"
                                            CornerRadius="8"
                                            ToolTipService.ToolTip="启动 Agent 模式 — AI 自主执行多步工具调用"
                                            AutomationProperties.Name="Agent 模式" AutomationProperties.HelpText="启动自主 AI Agent 执行多步工具调用">
                                            <FontIcon Glyph="&#xE7BF;" FontSize="13" Foreground="{ThemeResource VaultAccentBlue}" />
                                        </Button>
                                        <Button
                                            x:Name="StopAgentButton"
                                            MinWidth="0" MinHeight="0" Width="32" Height="32"
                                            Padding="0" Background="Transparent" BorderThickness="1"
                                            BorderBrush="{ThemeResource VaultBorder}"
                                            CornerRadius="8"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="停止 Agent" AutomationProperties.HelpText="立即终止 Agent 执行">
                                            <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="{ThemeResource VaultAccentRed}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Notes view: populated in code-behind -->
                    <Grid x:Name="NotesViewHost" Visibility="Collapsed" Padding="0" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <!-- Global AI Command Palette overlay (#2188) -->
        <controls:AiCommandPalette
            x:Name="AiCommandPaletteControl"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!-- Quick Ask overlay (#1799) -->
        <controls:QuickAskOverlay
            x:Name="QuickAskControl"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
        <!-- AI Command Palette overlay (Phase 2 of #2188) — hidden by default,
             shown on Ctrl+Shift+P or right-click AI context menu -->
        <Grid
            x:Name="AiCommandPaletteHost"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            Grid.RowSpan="2" />

    </Grid>
</Window>
