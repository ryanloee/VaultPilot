<UserControl
    x:Class="VaultPilot.WinUI.Controls.QuickAskOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Visibility="Collapsed">

    <!-- Semi-transparent backdrop -->
    <Grid x:Name="BackdropGrid" Background="#80000000"
          PointerPressed="OnBackdropPressed">

        <!-- Centered quick-ask card -->
        <Border
            x:Name="QuickAskCard"
            Width="540"
            MaxHeight="600"
            Padding="0"
            CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Translation="0,0,32">

            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border
                    Grid.Row="0"
                    Padding="16,14,16,12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Glyph="&#xE11A;"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="1"
                            Text="Quick Ask — 快速问答"
                            FontWeight="SemiBold"
                            FontSize="16"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="2"
                            Text="Ctrl+Shift+Q"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Input area -->
                <Border
                    Grid.Row="1"
                    Padding="16,12,16,12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="QuestionBox"
                            Grid.Column="0"
                            PlaceholderText="输入问题，AI 将基于知识库回答..."
                            AcceptsReturn="False"
                            MinHeight="40"
                            MaxHeight="100"
                            FontSize="14"
                            TextWrapping="Wrap"
                            TextChanged="OnQuestionTextChanged"
                            KeyDown="OnQuestionBoxKeyDown"
                            BorderThickness="1"
                            AutomationProperties.Name="快速问答输入框"
                            AutomationProperties.HelpText="输入问题后按 Enter 或点击提问按钮" />

                        <Button
                            x:Name="AskButton"
                            Grid.Column="1"
                            Content="提问"
                            Padding="16,8,16,8"
                            MinWidth="80"
                            MinHeight="40"
                            FontSize="14"
                            IsEnabled="False"
                            Click="OnAskClicked"
                            AutomationProperties.Name="提问"
                            AutomationProperties.HelpText="提交问题给 AI" />
                    </Grid>
                </Border>

                <!-- Response area -->
                <ScrollViewer
                    Grid.Row="2"
                    Padding="16,12,16,12"
                    VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="回答区域">
                    <StackPanel Spacing="12">
                        <!-- Answer content -->
                        <TextBlock
                            x:Name="AnswerText"
                            TextWrapping="Wrap"
                            FontSize="14"
                            Visibility="Collapsed"
                            AutomationProperties.Name="AI 回答内容" />

                        <!-- Citations -->
                        <ItemsControl
                            x:Name="CitationList"
                            Visibility="Collapsed"
                            AutomationProperties.Name="引用来源">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="8,6,8,6"
                                        Margin="0,2,0,2"
                                        CornerRadius="4"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding Snippet}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="2" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Status info -->
                        <TextBlock
                            x:Name="AnswerStatusText"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="Collapsed" />

                        <!-- Placeholder when no answer yet -->
                        <TextBlock
                            x:Name="PlaceholderText"
                            Text="输入问题后按 Enter 或点击「提问」开始..."
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,40,0,40" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer with actions -->
                <Border
                    Grid.Row="3"
                    Padding="16,8,16,10"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            x:Name="InsertToNoteButton"
                            Content="插入到笔记"
                            Padding="12,4,12,4"
                            MinWidth="0"
                            MinHeight="0"
                            FontSize="12"
                            Visibility="Collapsed"
                            Click="OnInsertToNoteClicked"
                            AutomationProperties.Name="插入回答到笔记"
                            AutomationProperties.HelpText="将 AI 回答插入到当前笔记编辑器中" />

                        <Button
                            Grid.Column="1"
                            x:Name="CopyButton"
                            Content="复制"
                            Padding="12,4,12,4"
                            MinWidth="0"
                            MinHeight="0"
                            FontSize="12"
                            Visibility="Collapsed"
                            Click="OnCopyClicked"
                            AutomationProperties.Name="复制回答"
                            AutomationProperties.HelpText="将 AI 回答复制到剪贴板" />

                        <TextBlock
                            Grid.Column="3"
                            x:Name="FooterHintText"
                            Text="Enter 提问 · Esc 关闭"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Loading overlay -->
        <Border
            x:Name="LoadingOverlay"
            Width="540"
            Height="140"
            Padding="0"
            CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Translation="0,0,32"
            Visibility="Collapsed">

            <StackPanel Orientation="Vertical" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressRing IsActive="True" Width="28" Height="28" />
                <TextBlock x:Name="LoadingText" Text="AI 思考中..." FontSize="14"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="AI 处理中" />
                <TextBlock x:Name="LoadingDetailText" Text="基于知识库检索和推理" FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
