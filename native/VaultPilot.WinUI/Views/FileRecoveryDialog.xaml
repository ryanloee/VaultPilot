<ContentDialog
    x:Class="VaultPilot.WinUI.Views.FileRecoveryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="860"
    Title="文件恢复"
    CloseButtonText="关闭"
    DefaultButton="Close"
    Width="860">

    <!-- #3960: browse / preview / restore vault-external crash-recovery
         snapshots (src/recovery.rs). Left: snapshot list (newest first);
         right: read-only content preview; bottom: action buttons. -->
    <Grid
        Width="820"
        Height="520"
        RowSpacing="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filter + refresh -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="FilterBox"
                Grid.Column="0"
                PlaceholderText="按路径或标题筛选快照..."
                TextChanged="OnFilterTextChanged"
                AutomationProperties.Name="筛选快照"
                AutomationProperties.HelpText="按笔记路径或标题过滤恢复快照列表" />
            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                Click="OnRefreshClicked"
                AutomationProperties.Name="刷新快照列表"
                AutomationProperties.HelpText="重新从后端加载恢复快照列表">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="刷新" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Snapshot list + preview -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Snapshot list -->
            <Border
                Grid.Column="0"
                Padding="8"
                Background="{ThemeResource VaultSidebarBg}"
                CornerRadius="8"
                BorderBrush="{ThemeResource VaultBorder}"
                BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Text="快照"
                        FontSize="{StaticResource VaultFontSizeMedium}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource VaultTextPrimary}"
                        Margin="4,0,0,4" />
                    <ListView
                        x:Name="SnapshotList"
                        Grid.Row="1"
                        MinHeight="0"
                        SelectionMode="Single"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Padding="0"
                        SelectionChanged="OnSnapshotSelectionChanged"
                        AutomationProperties.Name="恢复快照列表"
                        AutomationProperties.HelpText="选择一个快照预览内容，方向键可移动选择">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="2,6" Spacing="2">
                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource VaultTextPrimary}"
                                        TextWrapping="WrapWholeWords"
                                        MaxLines="2" />
                                    <TextBlock
                                        Text="{Binding PathDisplay}"
                                        FontSize="{StaticResource VaultFontSizeCaption}"
                                        Foreground="{ThemeResource SecondaryTextBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1"
                                        ToolTipService.ToolTip="{Binding PathDisplay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Text="{Binding TimeDisplay}"
                                            FontSize="{StaticResource VaultFontSizeCaption}"
                                            Foreground="{ThemeResource SecondaryTextBrush}" />
                                        <TextBlock
                                            Text="{Binding SizeDisplay}"
                                            FontSize="{StaticResource VaultFontSizeCaption}"
                                            Foreground="{ThemeResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!-- Empty state -->
                    <TextBlock
                        x:Name="EmptyListText"
                        Grid.Row="1"
                        Text="没有可恢复的快照"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- Preview pane -->
            <Border
                Grid.Column="1"
                Padding="12"
                Background="{ThemeResource VaultSidebarBg}"
                CornerRadius="8"
                BorderBrush="{ThemeResource VaultBorder}"
                BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Preview header (selected snapshot meta) -->
                    <StackPanel
                        x:Name="PreviewMetaPanel"
                        Grid.Row="0"
                        Spacing="2"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="PreviewTitle"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource VaultTextPrimary}"
                            TextWrapping="WrapWholeWords"
                            MaxLines="2" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock
                                x:Name="PreviewPath"
                                FontSize="{StaticResource VaultFontSizeCaption}"
                                Foreground="{ThemeResource SecondaryTextBrush}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <TextBlock
                                x:Name="PreviewTime"
                                FontSize="{StaticResource VaultFontSizeCaption}"
                                Foreground="{ThemeResource SecondaryTextBrush}" />
                            <TextBlock
                                x:Name="PreviewSize"
                                FontSize="{StaticResource VaultFontSizeCaption}"
                                Foreground="{ThemeResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Read-only content preview (scrolls internally) -->
                    <TextBox
                        x:Name="PreviewBox"
                        Grid.Row="1"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontFamily="Cascadia Code"
                        FontSize="12"
                        IsSpellCheckEnabled="False"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="{ThemeResource VaultTextPrimary}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed"
                        AutomationProperties.Name="快照内容预览"
                        AutomationProperties.HelpText="只读显示所选快照的完整内容" />

                    <!-- Preview placeholder / loading state -->
                    <TextBlock
                        x:Name="PreviewEmptyText"
                        Grid.Row="1"
                        Text="选择一个快照查看内容"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <!-- Action buttons -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8"
            HorizontalAlignment="Right">
            <Button
                x:Name="DeleteButton"
                Click="OnDeleteClicked"
                IsEnabled="False"
                AutomationProperties.Name="删除快照"
                AutomationProperties.HelpText="删除当前选中的恢复快照">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="删除" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                x:Name="RestoreButton"
                Style="{StaticResource VaultAccentButtonStyle}"
                Click="OnRestoreClicked"
                IsEnabled="False"
                AutomationProperties.Name="恢复快照"
                AutomationProperties.HelpText="将所选快照的内容写回库中原始笔记路径">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE81E;" FontSize="14" Foreground="{ThemeResource VaultOnAccentForeground}" />
                    <TextBlock Text="恢复" VerticalAlignment="Center" Foreground="{ThemeResource VaultOnAccentForeground}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Status (errors + restore/delete success) -->
        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="3"
            IsOpen="False"
            IsClosable="True"
            AutomationProperties.Name="操作状态"
            AutomationProperties.LiveSetting="Assertive" />

        <!-- Loading overlay -->
        <ProgressRing
            x:Name="LoadingRing"
            Grid.RowSpan="4"
            IsActive="False"
            Width="32"
            Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            AutomationProperties.Name="正在加载恢复快照" />
    </Grid>
</ContentDialog>
