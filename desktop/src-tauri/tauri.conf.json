{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaultPilot",
  "version": "0.7.24",
  "identifier": "com.local.vaultpilot.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "VaultPilot",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFNkFEMEJEQ0U3Rjk2N0QKUldSOWxuL092ZEJxenJZT2U3cHhOU1I5akJyaTBzdlR5TGZ4dEEvYk82enlZUmdjZGo3RGdDNUkK",
      "endpoints": [
        "https://github.com/ryanloee/VaultPilot/releases/latest/download/latest.json"
      ]
    }
  }
}