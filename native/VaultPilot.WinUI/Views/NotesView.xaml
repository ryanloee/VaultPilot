<UserControl
    x:Class="VaultPilot.WinUI.Views.NotesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="12" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Error info bar -->
        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="0"
            Severity="Error"
            IsOpen="False"
            IsClosable="True"
            Margin="0,0,0,4"
            AutomationProperties.Name="错误信息"
            AutomationProperties.HelpText="显示笔记操作的错误信息"
            AutomationProperties.LiveSetting="Assertive" />

        <!-- Search bar -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="搜索笔记标题、标签或内容..."
                QueryIcon="Find"
                AutomationProperties.Name="搜索笔记"
                AutomationProperties.HelpText="输入关键词搜索笔记" />
            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                AutomationProperties.Name="刷新笔记列表"
                AutomationProperties.HelpText="重新加载笔记列表">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="刷新" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                x:Name="CopyNoteButton"
                Grid.Column="2"
                IsEnabled="False"
                AutomationProperties.Name="复制笔记"
                AutomationProperties.HelpText="复制当前选中的笔记 (Ctrl+C)">
                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
            </Button>
            <Button
                x:Name="PasteNoteButton"
                Grid.Column="3"
                IsEnabled="False"
                AutomationProperties.Name="粘贴笔记"
                AutomationProperties.HelpText="粘贴（复制）上次复制的笔记 (Ctrl+V)">
                <FontIcon Glyph="&#xE77F;" FontSize="14" />
            </Button>
            <Button
                x:Name="DeleteNoteButton"
                Grid.Column="4"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                IsEnabled="False"
                AutomationProperties.Name="删除笔记"
                AutomationProperties.HelpText="删除当前选中的笔记">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="删除" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                x:Name="HistoryButton"
                Grid.Column="5"
                IsEnabled="False"
                AutomationProperties.Name="版本历史"
                AutomationProperties.HelpText="查看当前笔记的版本历史">
                <FontIcon Glyph="&#xE81E;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Notes list + detail + related notes split -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Notes list panel -->
            <Border
                Grid.Column="0"
                Padding="12"
                Background="{ThemeResource VaultSidebarBg}"
                CornerRadius="8"
                BorderBrush="{ThemeResource VaultBorder}"
                BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        x:Name="NotesCountLabel"
                        Text="笔记"
                        FontSize="{StaticResource VaultFontSizeMedium}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource VaultTextPrimary}" />
                    <ListView
                        x:Name="NotesList"
                        Grid.Row="1"
                        MinHeight="0"
                        SelectionMode="Single"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        AutomationProperties.Name="笔记列表"
                        AutomationProperties.HelpText="选择一篇笔记查看详情">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,4" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Text="{Binding Title}"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords"
                                        MaxLines="2" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{Binding Summary}"
                                        Foreground="{ThemeResource SecondaryTextBrush}"
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        TextWrapping="WrapWholeWords"
                                        MaxLines="2" />
                                    <StackPanel
                                        Grid.Row="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="0,2,0,0">
                                        <TextBlock
                                            Text="{Binding TagsDisplay}"
                                            FontSize="11"
                                            Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1" />
                                        <TextBlock
                                            Text="{Binding UpdatedDisplay}"
                                            FontSize="11"
                                            Foreground="{ThemeResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Note detail panel -->
            <Border
                x:Name="DetailPanel"
                Grid.Column="1"
                Padding="16"
                Background="{ThemeResource VaultCardBg}"
                CornerRadius="8"
                BorderBrush="{ThemeResource VaultBorder}"
                BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="DetailTitle"
                        Grid.Row="0"
                        Text="选择一篇笔记"
                        FontSize="{StaticResource VaultFontSizeMedium}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource VaultTextPrimary}"
                        TextWrapping="WrapWholeWords" />

                    <StackPanel
                        x:Name="DetailMetaPanel"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="DetailTags"
                            FontSize="12"
                            Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                            AutomationProperties.Name="笔记标签" />
                        <TextBlock
                            x:Name="DetailUpdated"
                            FontSize="12"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            AutomationProperties.Name="笔记更新时间" />
                        <TextBlock
                            x:Name="DetailPath"
                            FontSize="12"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1"
                            AutomationProperties.Name="笔记文件路径" />
                    </StackPanel>

                    <Border
                        x:Name="DetailSeparator"
                        Grid.Row="2"
                        Height="1"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}"
                        Visibility="Collapsed" />

                    <ScrollViewer
                        Grid.Row="3"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            x:Name="DetailBodyContainer"
                            Spacing="8"
                            AutomationProperties.Name="笔记内容"
                            AutomationProperties.HelpText="笔记的正文内容" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Related notes panel -->
            <Border
                x:Name="RelatedNotesPanel"
                Grid.Column="2"
                Padding="12"
                Background="{ThemeResource VaultSidebarBg}"
                CornerRadius="8"
                BorderBrush="{ThemeResource VaultBorder}"
                BorderThickness="1"
                Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Text="相关笔记"
                        FontSize="{StaticResource VaultFontSizeMedium}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource VaultTextPrimary}" />
                    <ProgressRing
                        x:Name="RelatedNotesLoading"
                        Grid.Row="1"
                        IsActive="False"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0"
                        Visibility="Collapsed" />
                    <ListView
                        x:Name="RelatedNotesList"
                        Grid.Row="2"
                        MinHeight="0"
                        SelectionMode="Single"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        AutomationProperties.Name="相关笔记"
                        AutomationProperties.HelpText="与当前笔记关联的其他笔记">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,6" RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Text="{Binding Title}"
                                        FontWeight="SemiBold"
                                        TextWrapping="WrapWholeWords"
                                        MaxLines="2" />
                                    <StackPanel
                                        Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="0,2,0,0">
                                        <TextBlock
                                            Text="{Binding TagsDisplay}"
                                            FontSize="11"
                                            Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="1" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource SecondaryTextBrush}">
                                            <Run Text="关联度:" />
                                            <Run Text="{Binding Score}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading overlay -->
        <ProgressRing
            x:Name="NotesLoading"
            Grid.RowSpan="2"
            IsActive="False"
            Width="32"
            Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="正在加载笔记"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
