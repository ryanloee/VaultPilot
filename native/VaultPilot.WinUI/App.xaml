<Application
    x:Class="VaultPilot.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:VaultPilot.WinUI.Converters"
    xmlns:models="using:VaultPilot.WinUI.Models">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

            <!-- ═══════════ Global Design Tokens (theme-independent) ═══════════ -->
            <!-- Font size scale (4-px rhythm adjacent steps) -->
            <x:Double x:Key="VaultFontSizeCaption">11</x:Double>
            <x:Double x:Key="VaultFontSizeSmall">12</x:Double>
            <x:Double x:Key="VaultFontSizeBody">14</x:Double>
            <x:Double x:Key="VaultFontSizeMedium">16</x:Double>
            <x:Double x:Key="VaultFontSizeLarge">20</x:Double>
            <x:Double x:Key="VaultFontSizeXLarge">28</x:Double>

            <!-- Corner radius scale (three semantic tiers) -->
            <CornerRadius x:Key="VaultRadiusSmall">4</CornerRadius>
            <CornerRadius x:Key="VaultRadiusMedium">8</CornerRadius>
            <CornerRadius x:Key="VaultRadiusLarge">12</CornerRadius>
            <CornerRadius x:Key="VaultRadiusPill">999</CornerRadius>

            <!-- Spacing scale (4-px grid) -->
            <Thickness x:Key="VaultSpaceXS">4</Thickness>
            <Thickness x:Key="VaultSpaceSM">8</Thickness>
            <Thickness x:Key="VaultSpaceMD">12</Thickness>
            <Thickness x:Key="VaultSpaceLG">16</Thickness>
            <Thickness x:Key="VaultSpaceXL">24</Thickness>

            <!-- Shared icon button dimensions -->
            <x:Double x:Key="VaultIconButtonSize">32</x:Double>
            <x:Double x:Key="VaultIconButtonGlyphSize">14</x:Double>

            <!-- Shared transition collections -->
            <TransitionCollection x:Key="AppChildrenTransitions">
                <EntranceThemeTransition FromVerticalOffset="12" IsStaggeringEnabled="True" />
                <RepositionThemeTransition />
                <AddDeleteThemeTransition />
            </TransitionCollection>

            <TransitionCollection x:Key="AppOverlayTransitions">
                <EntranceThemeTransition FromVerticalOffset="24" />
            </TransitionCollection>

            <!-- ═══════════ Reusable styles ═══════════ -->

            <!-- Icon button: transparent, square, with hover background + press scale -->
            <Style x:Key="VaultIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource VaultTextSecondary}" />
                <Setter Property="CornerRadius" Value="{StaticResource VaultRadiusMedium}" />
                <Setter Property="Width" Value="{StaticResource VaultIconButtonSize}" />
                <Setter Property="Height" Value="{StaticResource VaultIconButtonSize}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid.RenderTransform>
                                    <ScaleTransform />
                                </Grid.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource VaultTextPrimary}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.92" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.92" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Accent button: solid fill, opacity dip on hover, scale on press -->
            <Style x:Key="VaultAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource VaultAccentBlue}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource VaultOnAccentForeground}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource VaultRadiusMedium}" />
                <Setter Property="Width" Value="{StaticResource VaultIconButtonSize}" />
                <Setter Property="Height" Value="{StaticResource VaultIconButtonSize}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid.RenderTransform>
                                    <ScaleTransform />
                                </Grid.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.15" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.9" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.9" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Outlined icon button: bordered, for secondary actions (cancel/stop) -->
            <Style x:Key="VaultOutlinedIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource VaultBorder}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource VaultRadiusMedium}" />
                <Setter Property="Width" Value="{StaticResource VaultIconButtonSize}" />
                <Setter Property="Height" Value="{StaticResource VaultIconButtonSize}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid.RenderTransform>
                                    <ScaleTransform />
                                </Grid.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.92" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.92" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════ Theme-aware palette ═══════════ -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Design system: neutral grayscale (VS Code Light) -->
                    <SolidColorBrush x:Key="VaultSurfaceBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VaultCardBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VaultSidebarBg" Color="#F3F3F3" />
                    <!-- Elevated card (subtle shadow layer) -->
                    <SolidColorBrush x:Key="VaultCardElevatedBg" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="VaultBorder" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="VaultTextPrimary" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="VaultTextSecondary" Color="#6B6B6B" />
                    <SolidColorBrush x:Key="VaultTextMuted" Color="#9B9B9B" />
                    <!-- Message bubbles / cards -->
                    <SolidColorBrush x:Key="VaultBubbleUserBg" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="VaultBubbleUserFg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VaultBubbleAiBg" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="VaultBubbleAiFg" Color="#1E1E1E" />
                    <!-- Avatars -->
                    <SolidColorBrush x:Key="VaultAvatarUserBg" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="VaultAvatarUserFg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VaultAvatarAiBg" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="VaultAvatarAiFg" Color="#4B4B4B" />
                    <!-- Input area -->
                    <SolidColorBrush x:Key="VaultInputBg" Color="#FFFFFF" />
                    <!-- Foreground that sits on top of an accent-colored background -->
                    <SolidColorBrush x:Key="VaultOnAccentForeground" Color="#FFFFFF" />
                    <!-- Brand logo background (always high-contrast neutral) -->
                    <SolidColorBrush x:Key="VaultLogoBg" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="VaultLogoFg" Color="#FFFFFF" />
                    <!-- Status accents: monochrome (black accent for light theme) -->
                    <SolidColorBrush x:Key="VaultAccentBlue" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="VaultAccentGreen" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="VaultAccentOrange" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="VaultAccentRed" Color="#C42B1C" />
                    <!-- Overlay (modal backdrop) -->
                    <SolidColorBrush x:Key="VaultOverlayBrush" Color="#66000000" />
                    <!-- Code blocks -->
                    <SolidColorBrush x:Key="CodeBlockBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="CodeBlockForegroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="CodeInlineBackgroundBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="CodeInlineForegroundBrush" Color="#1E1E1E" />
                    <!-- Context usage bar -->
                    <SolidColorBrush x:Key="ContextUsageTrackBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="ContextUsageFillBrush" Color="#1E1E1E" />
                    <!-- Attachments -->
                    <SolidColorBrush x:Key="AttachmentDotBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="AttachmentBorderBrush" Color="#E5E5E5" />
                    <!-- Status bar -->
                    <SolidColorBrush x:Key="StatusBarIconBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="StatusErrorBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="StatusWarningBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="StatusInfoBrush" Color="#1E1E1E" />
                    <!-- Legacy aliases (kept for code-behind GetThemeBrush calls) -->
                    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#66000000" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B6B6B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- Design system: neutral grayscale (VS Code Dark+) -->
                    <SolidColorBrush x:Key="VaultSurfaceBg" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="VaultCardBg" Color="#252526" />
                    <SolidColorBrush x:Key="VaultSidebarBg" Color="#252526" />
                    <!-- Elevated card (one step brighter than CardBg for depth) -->
                    <SolidColorBrush x:Key="VaultCardElevatedBg" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="VaultBorder" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="VaultTextPrimary" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="VaultTextSecondary" Color="#969696" />
                    <SolidColorBrush x:Key="VaultTextMuted" Color="#6A6A6A" />
                    <!-- Message bubbles / cards -->
                    <SolidColorBrush x:Key="VaultBubbleUserBg" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="VaultBubbleUserFg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VaultBubbleAiBg" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="VaultBubbleAiFg" Color="#CCCCCC" />
                    <!-- Avatars -->
                    <SolidColorBrush x:Key="VaultAvatarUserBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VaultAvatarUserFg" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="VaultAvatarAiBg" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="VaultAvatarAiFg" Color="#CCCCCC" />
                    <!-- Input area -->
                    <SolidColorBrush x:Key="VaultInputBg" Color="#252526" />
                    <!-- Foreground that sits on top of an accent-colored background -->
                    <SolidColorBrush x:Key="VaultOnAccentForeground" Color="#1E1E1E" />
                    <!-- Brand logo background (always high-contrast neutral) -->
                    <SolidColorBrush x:Key="VaultLogoBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VaultLogoFg" Color="#1E1E1E" />
                    <!-- Status accents: monochrome (white accent for dark theme) -->
                    <SolidColorBrush x:Key="VaultAccentBlue" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VaultAccentGreen" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VaultAccentOrange" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="VaultAccentRed" Color="#F48771" />
                    <!-- Overlay (modal backdrop) -->
                    <SolidColorBrush x:Key="VaultOverlayBrush" Color="#99000000" />
                    <!-- Code blocks -->
                    <SolidColorBrush x:Key="CodeBlockBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="CodeBlockForegroundBrush" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="CodeInlineBackgroundBrush" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="CodeInlineForegroundBrush" Color="#CCCCCC" />
                    <!-- Context usage bar -->
                    <SolidColorBrush x:Key="ContextUsageTrackBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="ContextUsageFillBrush" Color="#FFFFFF" />
                    <!-- Attachments -->
                    <SolidColorBrush x:Key="AttachmentDotBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AttachmentBorderBrush" Color="#3C3C3C" />
                    <!-- Status bar -->
                    <SolidColorBrush x:Key="StatusBarIconBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="StatusErrorBrush" Color="#F48771" />
                    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="StatusInfoBrush" Color="#FFFFFF" />
                    <!-- Legacy aliases (kept for code-behind GetThemeBrush calls) -->
                    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#969696" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="VaultSurfaceBg" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="VaultCardBg" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="VaultSidebarBg" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="VaultCardElevatedBg" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="VaultBorder" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="VaultTextPrimary" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="VaultTextSecondary" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="VaultTextMuted" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="VaultBubbleUserBg" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="VaultBubbleUserFg" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="VaultBubbleAiBg" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="VaultBubbleAiFg" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="VaultAvatarUserBg" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="VaultAvatarUserFg" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="VaultAvatarAiBg" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="VaultAvatarAiFg" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="VaultInputBg" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="VaultOnAccentForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="VaultLogoBg" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="VaultLogoFg" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="VaultAccentBlue" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="VaultAccentGreen" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="VaultAccentOrange" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="VaultAccentRed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="VaultOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CodeBlockBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="CodeBlockForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="CodeInlineBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="CodeInlineForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="ContextUsageTrackBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="ContextUsageFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AttachmentDotBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AttachmentBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StatusBarIconBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="StatusErrorBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="StatusWarningBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="StatusInfoBrush" Color="{ThemeResource SystemColorHotlightColor}" />
                    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
