<Window
    x:Class="VaultPilot.WinUI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="设置">

    <Grid x:Name="RootGrid" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            x:Name="SettingsScroller"
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="Panel"
                Spacing="14"
                HorizontalAlignment="Stretch"
                Margin="20">

                <!-- Search box -->
                <TextBox
                    x:Name="SettingsSearchBox"
                    Header="搜索设置"
                    PlaceholderText="输入关键词过滤设置项..."
                    HorizontalAlignment="Stretch"
                    TextChanged="OnSettingsSearchTextChanged"
                    KeyDown="OnSearchBoxKeyDown"
                    AutomationProperties.Name="设置搜索框"
                    AutomationProperties.HelpText="输入关键词过滤设置项；Esc 清空，↓ 进入设置卡片" />

                <!-- Inline error bar -->
                <InfoBar
                    x:Name="ErrorInfoBar"
                    Severity="Error"
                    Title="设置校验失败"
                    IsOpen="False"
                    IsClosable="False"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="设置校验错误提示" />

                <!-- No-results empty state -->
                <TextBlock
                    x:Name="NoResultsText"
                    Text="无匹配设置项"
                    FontSize="14"
                    Foreground="{ThemeResource VaultTextSecondary}"
                    HorizontalAlignment="Center"
                    Padding="0,24,0,8"
                    Visibility="Collapsed"
                    AutomationProperties.Name="搜索无结果提示" />

                <!-- Card: Knowledge Vault -->
                <Border Background="{ThemeResource VaultCardBg}" CornerRadius="12"
                        BorderBrush="{ThemeResource VaultBorder}" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource VaultAccentBlue}" VerticalAlignment="Center" />
                            <TextBlock Text="知识库" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource VaultTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox
                            x:Name="VaultBox"
                            Header="知识库目录"
                            PlaceholderText="例如 D:\KnowledgeVault"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="知识库目录路径" />
                        <Button
                            x:Name="OpenVaultButton"
                            Content="打开目录"
                            AutomationProperties.Name="打开知识库目录"
                            AutomationProperties.HelpText="打开文件选择对话框选择知识库目录" />
                    </StackPanel>
                </Border>

                <!-- Card: AI Provider -->
                <Border Background="{ThemeResource VaultCardBg}" CornerRadius="12"
                        BorderBrush="{ThemeResource VaultBorder}" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="{ThemeResource VaultAccentBlue}" VerticalAlignment="Center" />
                            <TextBlock Text="AI 提供商" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource VaultTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ListView
                            x:Name="ProviderList"
                            MaxHeight="140"
                            SelectionChanged="OnProviderSelectionChanged"
                            SelectionMode="Single"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="提供商列表" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AddProviderButton" Click="OnAddProvider">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="添加" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RemoveProviderButton" Click="OnRemoveProvider">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource VaultAccentRed}" />
                                    <TextBlock Text="删除" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBox
                            x:Name="ProviderNameBox"
                            Header="名称"
                            PlaceholderText="例如 OpenCode Zen"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="提供商名称" />
                        <InfoBar
                            x:Name="FreeTierHint"
                            Severity="Informational"
                            Title="免费使用"
                            Message="选 OpenCode Zen 或 OpenRouter 即可免费体验 AI 对话&#x0a;• OpenCode Zen：opencode.ai/zen（注册即送免费模型）&#x0a;• OpenRouter：openrouter.ai（GitHub 登录，27 个免费模型）"
                            IsOpen="True"
                            IsClosable="False"
                            HorizontalAlignment="Stretch" />
                        <ComboBox
                            x:Name="ProviderTypeBox"
                            Header="格式"
                            HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="OpenAI" IsSelected="True" />
                            <ComboBoxItem Content="Anthropic" />
                            <ComboBoxItem Content="Ollama" />
                        </ComboBox>
                        <PasswordBox
                            x:Name="ApiKeyBox"
                            Header="API Key"
                            PlaceholderText="在 opencode.ai/zen 或 openrouter.ai 获取"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="API Key" />
                        <TextBlock
                            x:Name="ApiKeyError"
                            Foreground="{ThemeResource StatusErrorBrush}"
                            FontSize="12"
                            Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Polite" />
                        <TextBox
                            x:Name="BaseUrlBox"
                            Header="接口地址"
                            PlaceholderText="例如 https://opencode.ai/zen/v1"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="模型服务接口地址" />
                        <TextBlock
                            x:Name="BaseUrlError"
                            Foreground="{ThemeResource StatusErrorBrush}"
                            FontSize="12"
                            Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Polite" />
                        <TextBox
                            x:Name="ModelBox"
                            Header="模型"
                            PlaceholderText="例如 deepseek-v4-flash-free"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="模型名称" />
                        <TextBlock
                            x:Name="ModelError"
                            Foreground="{ThemeResource StatusErrorBrush}"
                            FontSize="12"
                            Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Polite" />
                        <TextBox
                            x:Name="TimeoutBox"
                            Header="请求超时（毫秒）"
                            HorizontalAlignment="Stretch"
                            LostFocus="OnTimeoutLostFocus"
                            AutomationProperties.Name="请求超时毫秒数" />
                        <TextBlock
                            x:Name="TimeoutError"
                            Foreground="{ThemeResource StatusErrorBrush}"
                            FontSize="12"
                            Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Polite" />
                        <TextBox
                            x:Name="ContextWindowBox"
                            Header="上下文窗口 Token 数（可选）"
                            HorizontalAlignment="Stretch"
                            LostFocus="OnContextWindowLostFocus"
                            AutomationProperties.Name="上下文窗口 Token 数" />
                        <TextBlock
                            x:Name="ContextWindowError"
                            Foreground="{ThemeResource StatusErrorBrush}"
                            FontSize="12"
                            Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Polite" />
                        <!-- #3480: Test connection -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="TestConnectionButton"
                                Click="OnTestConnectionClick"
                                AutomationProperties.Name="测试连接">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="12" />
                                    <TextBlock Text="测试连接" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ProgressRing
                                x:Name="TestConnectionProgress"
                                IsActive="False"
                                Width="18"
                                Height="18"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <InfoBar
                            x:Name="TestConnectionResult"
                            IsOpen="False"
                            IsClosable="True"
                            Severity="Informational"
                            Title="测试连接"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="测试连接结果"
                            AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <!-- Card: Preferences -->
                <Border Background="{ThemeResource VaultCardBg}" CornerRadius="12"
                        BorderBrush="{ThemeResource VaultBorder}" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE771;" FontSize="14" Foreground="{ThemeResource VaultAccentBlue}" VerticalAlignment="Center" />
                            <TextBlock Text="偏好" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource VaultTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox
                            x:Name="AutoCheckUpdatesBox"
                            Content="启动时自动检查更新"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="启动时自动检查更新" />
                        <CheckBox
                            x:Name="AlwaysOnTopBox"
                            Content="窗口置顶 / Always on Top"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="窗口置顶 / Always on Top" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="主题" FontSize="12" Foreground="{ThemeResource VaultTextSecondary}" />
                            <RadioButtons x:Name="ThemeModeRadio" MaxColumns="1">
                                <RadioButton x:Name="ThemeSystem" Content="跟随系统" Checked="OnThemeChecked" />
                                <RadioButton x:Name="ThemeLight" Content="亮色" Checked="OnThemeChecked" />
                                <RadioButton x:Name="ThemeDark" Content="暗色" Checked="OnThemeChecked" />
                            </RadioButtons>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border x:Name="AvatarPreviewBorder" Width="44" Height="44" CornerRadius="22"
                                    Background="{ThemeResource VaultAvatarUserBg}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="头像预览">
                                <TextBlock x:Name="AvatarPreviewText" Text="我" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{ThemeResource VaultAvatarUserFg}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="头像" FontSize="12" Foreground="{ThemeResource VaultTextSecondary}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ChooseAvatarButton" Click="OnChooseAvatarClick"
                                            Content="选择图片…" AutomationProperties.Name="选择头像图片" />
                                    <Button x:Name="ClearAvatarButton" Click="OnClearAvatarClick"
                                            Content="恢复默认" AutomationProperties.Name="清除头像" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <TextBox
                            x:Name="ProxyUrlBox"
                            Header="代理地址（可选）"
                            PlaceholderText="例如 http://127.0.0.1:7897"
                            AutomationProperties.Name="代理地址"
                            HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <!-- Card: Auto Wake -->
                <Border Background="{ThemeResource VaultCardBg}" CornerRadius="12"
                        BorderBrush="{ThemeResource VaultBorder}" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE917;" FontSize="14" Foreground="{ThemeResource VaultAccentBlue}" VerticalAlignment="Center" />
                            <TextBlock Text="自动唤醒" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource VaultTextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox
                            x:Name="AutoWakeEnabledBox"
                            Content="启用自动唤醒（定时调用 API 保持会话活跃）"
                            HorizontalAlignment="Left"
                            Checked="OnAutoWakeToggled"
                            Unchecked="OnAutoWakeToggled"
                            AutomationProperties.Name="启用自动唤醒"
                            AutomationProperties.HelpText="定时调用 API 保持会话活跃" />
                        <TextBox
                            x:Name="AutoWakeIntervalBox"
                            Header="唤醒间隔（分钟）"
                            PlaceholderText="30"
                            HorizontalAlignment="Stretch"
                            LostFocus="OnAutoWakeIntervalLostFocus"
                            AutomationProperties.Name="唤醒间隔分钟" />
                        <TextBlock
                            x:Name="AutoWakeIntervalError"
                            Foreground="{ThemeResource StatusErrorBrush}"
                            FontSize="12"
                            Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Polite" />
                        <ComboBox
                            x:Name="AutoWakeModelBox"
                            Header="唤醒使用的模型（留空使用默认模型）"
                            HorizontalAlignment="Stretch"
                            IsEditable="True"
                            AutomationProperties.Name="唤醒使用的模型" />
                        <TextBox
                            x:Name="AutoWakeStartTimeBox"
                            Header="开始时间（HH:mm，留空不限）"
                            PlaceholderText="05:00"
                            HorizontalAlignment="Stretch"
                            LostFocus="OnAutoWakeStartTimeLostFocus"
                            AutomationProperties.Name="自动唤醒开始时间" />
                        <TextBlock
                            x:Name="AutoWakeStartTimeError"
                            Foreground="{ThemeResource StatusErrorBrush}"
                            FontSize="12"
                            Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Polite" />
                        <TextBox
                            x:Name="AutoWakeEndTimeBox"
                            Header="结束时间（HH:mm，留空不限）"
                            PlaceholderText="23:00"
                            HorizontalAlignment="Stretch"
                            LostFocus="OnAutoWakeEndTimeLostFocus"
                            AutomationProperties.Name="自动唤醒结束时间" />
                        <TextBlock
                            x:Name="AutoWakeEndTimeError"
                            Foreground="{ThemeResource StatusErrorBrush}"
                            FontSize="12"
                            Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Polite" />
                        <TextBox
                            x:Name="AutoWakePromptBox"
                            Header="唤醒提问内容（留空使用默认提示）"
                            PlaceholderText="请简要回顾一下最近的知识库内容，给我一个简短的今日摘要。"
                            HorizontalAlignment="Stretch"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            MinHeight="60"
                            MaxHeight="120"
                            AutomationProperties.Name="唤醒提问内容" />
                        <TextBlock
                            x:Name="NextWakeLabel"
                            Foreground="{ThemeResource VaultTextSecondary}" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- Footer row -->
                <Grid ColumnSpacing="12" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="ProjectLinkButton"
                        Grid.Column="0"
                        Content="项目地址"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="打开项目地址"
                        AutomationProperties.HelpText="在浏览器中打开 VaultPilot 项目页面" />
                    <TextBlock
                        x:Name="VersionLabel"
                        Grid.Column="1"
                        Foreground="{ThemeResource VaultTextMuted}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right" />
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom action bar -->
        <Grid Grid.Row="1" Padding="16,12" ColumnSpacing="8" Background="{ThemeResource VaultCardBg}"
              BorderBrush="{ThemeResource VaultBorder}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ActionBarStatus" Grid.Column="0" Foreground="{ThemeResource VaultTextSecondary}"
                       FontSize="12" VerticalAlignment="Center" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="取消" Click="OnCancelClick"
                    MinWidth="80" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Grid.Column="2" Content="保存" Click="OnSaveClick"
                    MinWidth="80" Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>