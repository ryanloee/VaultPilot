<Window
    x:Class="VaultPilot.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:VaultPilot.WinUI.Controls"
    mc:Ignorable="d"
    Title="VaultPilot">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewSessionAccelerator" />
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="OnToggleSidebarAccelerator" />
            <KeyboardAccelerator Key="P" Modifiers="Control,Shift" Invoked="OnAiCommandPaletteAccelerator" />
            <KeyboardAccelerator Key="Q" Modifiers="Control,Shift" Invoked="OnQuickAskAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status bar + CommandBar (always visible) -->
        <Grid Grid.Row="0" Padding="8,4,8,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="StatusBar"
                Grid.Column="0"
                MinWidth="280"
                Padding="12,6,12,6"
                CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    AutomationProperties.Name="状态栏">
                    <FontIcon x:Name="StatusBarIcon" Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource StatusBarIconBrush}"
                        AutomationProperties.Name="状态图标" />
                    <TextBlock x:Name="StatusBarTitle" Text="正在启动" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                        AutomationProperties.Name="状态标题" />
                    <TextBlock x:Name="StatusBarMessage" Text="正在连接 Rust 后端..." Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                        AutomationProperties.Name="状态消息" />
                </StackPanel>
            </Border>
            <CommandBar
                Grid.Column="1"
                DefaultLabelPosition="Right"
                IsOpen="False">
                <AppBarButton x:Name="ToggleSidebarButton" Icon="OpenPane" Label="收起会话"
                    AutomationProperties.Name="切换侧边栏" AutomationProperties.HelpText="显示或隐藏会话列表侧边栏" />
                <AppBarButton x:Name="ImportButton" Icon="Import" Label="导入 Markdown"
                    AutomationProperties.Name="导入 Markdown" AutomationProperties.HelpText="从本地导入 Markdown 文件到知识库" />
                <AppBarButton x:Name="RebuildButton" Icon="Refresh" Label="重建索引"
                    AutomationProperties.Name="重建索引" AutomationProperties.HelpText="重建知识库搜索索引" />
                <AppBarButton x:Name="SettingsButton" Icon="Setting" Label="设置"
                    AutomationProperties.Name="设置" AutomationProperties.HelpText="打开应用设置对话框" />
            </CommandBar>
        </Grid>

        <!-- NavigationView + content area -->
        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavChat"
                    Content="对话"
                    Icon="Message"
                    Tag="Chat"
                    IsSelected="True"
                    AutomationProperties.Name="对话"
                    AutomationProperties.HelpText="切换到聊天界面" />
                <NavigationViewItem
                    x:Name="NavNotes"
                    Content="笔记"
                    Tag="Notes"
                    AutomationProperties.Name="笔记"
                    AutomationProperties.HelpText="切换到笔记浏览界面" />
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Grid>
                    <!-- Chat view -->
                    <Grid x:Name="ChatView" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="24" RowSpacing="16">
                            <Grid x:Name="ContentGrid" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="SidebarColumn" Width="280" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="SidebarBorder"
                                    Grid.Column="0"
                                    Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="会话" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock Grid.Row="1" x:Name="NotesText" Text="笔记：正在加载..."
                                            AutomationProperties.Name="笔记状态" AutomationProperties.HelpText="显示笔记同步状态信息" />
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="NewSessionButton"
                                                AutomationProperties.Name="新建对话" AutomationProperties.HelpText="创建一个新的聊天会话">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                                    <TextBlock Text="新建对话" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="DeleteSessionButton" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                AutomationProperties.Name="删除当前会话" AutomationProperties.HelpText="删除当前选中的聊天会话">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    <TextBlock Text="删除当前会话" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <ListView
                                            x:Name="SessionList"
                                            Grid.Row="3"
                                            MinHeight="0"
                                            SelectionMode="Single"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            AutomationProperties.Name="会话列表" AutomationProperties.HelpText="选择一个聊天会话">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Title}" TextWrapping="WrapWholeWords" />
                                                        <TextBlock
                                                            Text="{Binding Detail}"
                                                            Foreground="{ThemeResource SecondaryTextBrush}"
                                                            Style="{ThemeResource BodyTextBlockStyle}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <ScrollViewer
                                            x:Name="ChatScrollViewer"
                                            Margin="0,0,-10,0"
                                            VerticalScrollBarVisibility="Auto">
                                            <StackPanel
                                                x:Name="MessagesPanel"
                                                Margin="0,0,18,0"
                                                Spacing="12">
                                                <TextBlock Text="对话" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                                <TextBlock Text="正在接入原生 Windows 界面。" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </ScrollViewer>
                                        <!-- Agent tool call status panel -->
                                        <Border
                                            x:Name="AgentToolCallPanel"
                                            Grid.Row="1"
                                            Padding="12"
                                            Margin="0,8,0,0"
                                            CornerRadius="6"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="Agent 工具调用面板">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <!-- Agent status header -->
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                                    <ProgressRing x:Name="AgentProgressRing" IsActive="True" Width="16" Height="16" />
                                                    <TextBlock x:Name="AgentStatusText" Text="Agent 运行中..." FontWeight="SemiBold" />
                                                    <TextBlock x:Name="AgentStepCount" Text="步骤: 0/20" Opacity="0.7" />
                                                    <TextBlock x:Name="AgentTokenCount" Text="Token: 0" Opacity="0.7" />
                                                </StackPanel>
                                                <!-- Tool call list -->
                                                <ScrollViewer Grid.Row="1" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel x:Name="AgentToolCallList" Spacing="4" />
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                        <Button
                                            x:Name="JumpLatestButton"
                                            Margin="0,8,0,0"
                                            Padding="12,6,12,6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Content="回到最新对话"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="回到最新对话" AutomationProperties.HelpText="滚动到最新的聊天消息" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" Padding="24,0,24,24">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        x:Name="ComposerDropZone"
                                        Grid.Column="0"
                                        RowSpacing="6"
                                        AllowDrop="True"
                                        DragOver="OnComposerDropZoneDragOver"
                                        Drop="OnComposerDropZoneDrop"
                                        AutomationProperties.Name="消息编辑区域"
                                        AutomationProperties.HelpText="支持拖放文件作为附件">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox
                                            x:Name="ComposerBox"
                                            Grid.Row="0"
                                            AcceptsReturn="False"
                                            MinHeight="88"
                                            MaxHeight="200"
                                            TextChanged="OnComposerTextChanged"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            TextWrapping="Wrap"
                                            PlaceholderText="输入问题，或记录一条知识... (Enter 发送，Shift+Enter 换行)"
                                            ToolTipService.ToolTip="Enter 发送消息，Shift+Enter 插入换行"
                                            AutomationProperties.Name="消息输入框" AutomationProperties.HelpText="输入要发送的消息，Enter 发送，Shift+Enter 换行">
                                        </TextBox>
                                        <ProgressRing
                                            x:Name="ComposerProgressRing"
                                            Grid.Row="1"
                                            IsActive="False"
                                            Width="16"
                                            Height="16"
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="4,0,0,0"
                                            AutomationProperties.Name="正在处理" />
                                        <TextBlock
                                            x:Name="ComposerHintText"
                                            Grid.Row="2"
                                            Text="Enter 发送 · Shift+Enter 换行"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Margin="4,0,0,0"
                                            HorizontalAlignment="Right" />
                                        <Grid
                                            x:Name="ContextUsageBarHost"
                                            Grid.Row="3"
                                            Height="8"
                                            MinWidth="120"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            SizeChanged="OnContextUsageBarHostSizeChanged"
                                            AutomationProperties.Name="上下文使用量" AutomationProperties.HelpText="显示当前会话的上下文窗口使用百分比">
                                            <Border
                                                x:Name="ContextUsageTrack"
                                                Height="4"
                                                CornerRadius="2"
                                                Background="{ThemeResource ContextUsageTrackBrush}"
                                                Opacity="0.32"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center" />
                                            <Border
                                                x:Name="ContextUsageFill"
                                                Height="4"
                                                Width="0"
                                                CornerRadius="2"
                                                Background="{ThemeResource ContextUsageFillBrush}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                        <ScrollViewer
                                            x:Name="AttachmentScroller"
                                            Grid.Row="4"
                                            Margin="0,4,0,0"
                                            HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Disabled"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="附件列表"
                                            AutomationProperties.HelpText="已添加的附件，可左右滚动浏览">
                                            <StackPanel
                                                x:Name="AttachmentPanel"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="附件面板" />
                                        </ScrollViewer>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="8" HorizontalAlignment="Center">
                                        <Button
                                            x:Name="RecordButton"
                                            Content="记录"
                                            ToolTipService.ToolTip="将当前对话内容记录到知识库"
                                            AutomationProperties.Name="记录" AutomationProperties.HelpText="将当前对话内容记录到知识库" />
                                        <Button
                                            x:Name="SendButton"
                                            Content="发送"
                                            AutomationProperties.Name="发送" AutomationProperties.HelpText="发送消息到 AI" />
                                        <Button
                                            x:Name="CancelButton"
                                            Content="取消"
                                            Visibility="Collapsed"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            AutomationProperties.Name="取消" AutomationProperties.HelpText="取消当前 AI 请求" />
                                        <Button
                                            x:Name="AgentModeButton"
                                            Content="Agent"
                                            ToolTipService.ToolTip="启动 Agent 模式 — AI 自主执行多步工具调用"
                                            Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                            AutomationProperties.Name="Agent 模式" AutomationProperties.HelpText="启动自主 AI Agent 执行多步工具调用" />
                                        <Button
                                            x:Name="StopAgentButton"
                                            Content="停止"
                                            Visibility="Collapsed"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            AutomationProperties.Name="停止 Agent" AutomationProperties.HelpText="立即终止 Agent 执行" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Notes view: populated in code-behind -->
                    <Grid x:Name="NotesViewHost" Visibility="Collapsed" Padding="0" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <!-- Global AI Command Palette overlay (#2188) -->
        <controls:AiCommandPalette
            x:Name="AiCommandPaletteControl"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!-- Quick Ask overlay (#1799) -->
        <controls:QuickAskOverlay
            x:Name="QuickAskControl"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

    </Grid>
</Window>
