<ContentDialog
    x:Class="VaultPilot.WinUI.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="设置"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    Width="520"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer
        MaxHeight="520"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            x:Name="Panel"
            Spacing="12"
            HorizontalAlignment="Stretch">

            <!-- Inline error bar -->
            <InfoBar
                x:Name="ErrorInfoBar"
                Severity="Error"
                Title="设置校验失败"
                IsOpen="False"
                IsClosable="False"
                HorizontalAlignment="Stretch" />

            <!-- Vault directory -->
            <TextBox
                x:Name="VaultBox"
                Header="知识库目录"
                PlaceholderText="例如 D:\KnowledgeVault"
                HorizontalAlignment="Stretch" />
            <Button
                x:Name="OpenVaultButton"
                Content="打开目录" />

            <!-- Provider settings -->
            <PasswordBox
                x:Name="ApiKeyBox"
                Header="API Key"
                PlaceholderText="输入模型服务 API Key"
                HorizontalAlignment="Stretch" />
            <TextBox
                x:Name="BaseUrlBox"
                Header="接口地址"
                PlaceholderText="例如 https://api.openai.com/v1"
                HorizontalAlignment="Stretch" />
            <TextBox
                x:Name="ModelBox"
                Header="模型"
                PlaceholderText="例如 gpt-4o-mini"
                HorizontalAlignment="Stretch" />

            <!-- Timeout -->
            <TextBox
                x:Name="TimeoutBox"
                Header="请求超时（毫秒）"
                HorizontalAlignment="Stretch"
                LostFocus="OnTimeoutLostFocus" />
            <TextBlock
                x:Name="TimeoutError"
                Foreground="{ThemeResource StatusErrorBrush}"
                FontSize="12"
                Visibility="Collapsed"
                Margin="0,-8,0,0" />

            <!-- Context window tokens -->
            <TextBox
                x:Name="ContextWindowBox"
                Header="上下文窗口 Token 数（可选）"
                HorizontalAlignment="Stretch"
                LostFocus="OnContextWindowLostFocus" />
            <TextBlock
                x:Name="ContextWindowError"
                Foreground="{ThemeResource StatusErrorBrush}"
                FontSize="12"
                Visibility="Collapsed"
                Margin="0,-8,0,0" />

            <!-- Auto-wake section -->
            <Border
                Height="1"
                Background="{ThemeResource CardStrokeColorDefaultBrush}"
                Margin="0,4,0,4" />
            <TextBlock
                Text="自动唤醒"
                FontWeight="SemiBold" />
            <CheckBox
                x:Name="AutoWakeEnabledBox"
                Content="启用自动唤醒（定时调用 API 保持会话活跃）"
                HorizontalAlignment="Left"
                Checked="OnAutoWakeToggled"
                Unchecked="OnAutoWakeToggled" />
            <TextBox
                x:Name="AutoWakeIntervalBox"
                Header="唤醒间隔（分钟）"
                PlaceholderText="30"
                HorizontalAlignment="Stretch"
                LostFocus="OnAutoWakeIntervalLostFocus" />
            <TextBlock
                x:Name="AutoWakeIntervalError"
                Foreground="{ThemeResource StatusErrorBrush}"
                FontSize="12"
                Visibility="Collapsed"
                Margin="0,-8,0,0" />
            <ComboBox
                x:Name="AutoWakeModelBox"
                Header="唤醒使用的模型（留空使用默认模型）"
                HorizontalAlignment="Stretch"
                IsEditable="True" />
            <TextBox
                x:Name="AutoWakeStartTimeBox"
                Header="开始时间（HH:mm，留空不限）"
                PlaceholderText="05:00"
                HorizontalAlignment="Stretch"
                LostFocus="OnAutoWakeStartTimeLostFocus" />
            <TextBlock
                x:Name="AutoWakeStartTimeError"
                Foreground="{ThemeResource StatusErrorBrush}"
                FontSize="12"
                Visibility="Collapsed"
                Margin="0,-8,0,0" />
            <TextBox
                x:Name="AutoWakeEndTimeBox"
                Header="结束时间（HH:mm，留空不限）"
                PlaceholderText="23:00"
                HorizontalAlignment="Stretch"
                LostFocus="OnAutoWakeEndTimeLostFocus" />
            <TextBlock
                x:Name="AutoWakeEndTimeError"
                Foreground="{ThemeResource StatusErrorBrush}"
                FontSize="12"
                Visibility="Collapsed"
                Margin="0,-8,0,0" />

            <!-- Next wake time -->
            <TextBlock
                x:Name="NextWakeLabel"
                Opacity="0.7" />

            <!-- Footer row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    x:Name="AutoCheckUpdatesBox"
                    Grid.Column="0"
                    Content="启动时自动检查更新"
                    HorizontalAlignment="Left" />
                <Button
                    x:Name="ProjectLinkButton"
                    Grid.Column="1"
                    Content="项目地址"
                    HorizontalAlignment="Left" />
                <TextBlock
                    x:Name="VersionLabel"
                    Grid.Column="2"
                    Opacity="0.6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
