<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <CargoTomlPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\Cargo.toml'))</CargoTomlPath>
    <CargoTomlText>$([System.IO.File]::ReadAllText('$(CargoTomlPath)'))</CargoTomlText>
    <AppVersion>$([System.Text.RegularExpressions.Regex]::Match('$(CargoTomlText)', '(?m)^version\s*=\s*"([^"]+)"').Groups[1].Value)</AppVersion>
    <AppVersionNumeric>$([System.Text.RegularExpressions.Regex]::Match('$(AppVersion)', '^(\d+\.\d+\.\d+)').Groups[1].Value)</AppVersionNumeric>
    <Version Condition="'$(AppVersion)' != ''">$(AppVersion)</Version>
    <AssemblyVersion Condition="'$(AppVersionNumeric)' != ''">$(AppVersionNumeric).0</AssemblyVersion>
    <FileVersion Condition="'$(AppVersionNumeric)' != ''">$(AppVersionNumeric).0</FileVersion>
    <InformationalVersion Condition="'$(AppVersion)' != ''">$(AppVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>VaultPilot.WinUI</AssemblyName>
    <RootNamespace>VaultPilot.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkBootstrapInitialize>true</WindowsAppSdkBootstrapInitialize>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <RustTargetDir Condition="'$(Configuration)'=='Release'">release</RustTargetDir>
    <RustTargetDir Condition="'$(Configuration)'!='Release'">debug</RustTargetDir>
    <RustProfile Condition="'$(Configuration)'=='Release'">--release</RustProfile>
    <RustProfile Condition="'$(Configuration)'!='Release'"></RustProfile>
    <RustTarget Condition="'$(Platform)'=='x86'">i686-pc-windows-msvc</RustTarget>
    <RustTarget Condition="'$(Platform)'=='x64'">x86_64-pc-windows-msvc</RustTarget>
    <RustTarget Condition="'$(Platform)'=='arm64'">aarch64-pc-windows-msvc</RustTarget>
    <RustTarget Condition="'$(Platform)'==''">x86_64-pc-windows-msvc</RustTarget>
    <RustCargoTargetArg Condition="'$(RustTarget)'!=''">--target $(RustTarget)</RustCargoTargetArg>
    <RustAgentPath>$(MSBuildProjectDirectory)\..\..\target\$(RustTarget)\$(RustTargetDir)\vaultpilot-agent.exe</RustAgentPath>
    <RustCliPath>$(MSBuildProjectDirectory)\..\..\target\$(RustTarget)\$(RustTargetDir)\vaultpilot-cli.exe</RustCliPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildRustBinaries" BeforeTargets="Build" Condition="Exists('$(USERPROFILE)\.cargo\bin\cargo.exe')">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)\..\.."
      Command="&quot;$(USERPROFILE)\.cargo\bin\cargo.exe&quot; build --bin vaultpilot-agent --bin vaultpilot-cli $(RustProfile) $(RustCargoTargetArg)" />
  </Target>

  <Target
    Name="CopyRustBinaries"
    AfterTargets="Build">
    <ItemGroup>
      <RustRuntimeFiles Include="$(RustAgentPath)" Condition="Exists('$(RustAgentPath)')" />
      <RustRuntimeFiles Include="$(RustCliPath)" Condition="Exists('$(RustCliPath)')" />
    </ItemGroup>
    <Copy
      SourceFiles="@(RustRuntimeFiles)"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true"
      Condition="'@(RustRuntimeFiles)' != ''" />
  </Target>

  <Target
    Name="CopyRustBinariesToPublish"
    AfterTargets="Publish"
    Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <RustPublishFiles Include="$(RustAgentPath)" Condition="Exists('$(RustAgentPath)')" />
      <RustPublishFiles Include="$(RustCliPath)" Condition="Exists('$(RustCliPath)')" />
    </ItemGroup>
    <Copy
      SourceFiles="@(RustPublishFiles)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true"
      Condition="'@(RustPublishFiles)' != ''" />
  </Target>
</Project>
